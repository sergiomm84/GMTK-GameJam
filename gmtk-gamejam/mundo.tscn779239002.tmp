[sub_resource type="GDScript" id="GDScript_5ckkb"]
script/source = "extends Sprite2D


@onready var timey = $Timer

var rotation_speed_degrees = 1.0  # Degrees per second

  
func _ready() -> void:
	timey.start(1)
	

func _on_timer_timeout() -> void:
	rotation_degrees.y += rotation_speed_degrees * 1.0 # Rotate around the Y axis
"

